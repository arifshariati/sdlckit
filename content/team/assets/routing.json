    "staff-engineer": "high",
    "product-owner": "high",
    "ui-ux-designer": "medium",
    "engineer": "medium",
    "engineer@small": "low",
    "technical-writer": "low",
    "delivery-manager": "low",
    "business-analyst": "medium",
    "devops-engineer": "medium"
  },
  "engineers": {
    "react-web": "frontend-engineer",
    "vite-build": "frontend-engineer",
    "react-native": "mobile-engineer",
    "nestjs": "backend-engineer",
    "supabase": "data-engineer",
    "postgres": "data-engineer",
    "aws": "infra-engineer",
    "terraform": "infra-engineer",
    "turbo-monorepo": "infra-engineer",
    "bedrock-agentcore": "ai-engineer"
