{
  "name": "sdlckit-monorepo",
  "private": true,
  "description": "Claude Code, engineered. Monorepo for the sdlckit workflow.",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "content:validate": "node packages/validators/dist/cli.js .",
    "content:generate": "node packages/generator/dist/cli.js .",
    "content:check": "node packages/generator/dist/cli.js --check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
